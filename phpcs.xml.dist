<?xml version="1.0"?>
<ruleset name="Bulk Mailing Lists" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/squizlabs/PHP_CodeSniffer/master/phpcs.xsd">
	<description>Coding standards for the Bulk Mailing Lists plugin.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>
	<arg name="parallel" value="8"/>

	<!-- Warnings are reported but do not fail the build. -->
	<config name="ignore_warnings_on_exit" value="1"/>

	<rule ref="WordPress">
		<!-- Files are named class-mlp-*.php to match the MLP_* classes they hold. -->
		<exclude name="WordPress.Files.FileName"/>

		<!-- The plugin owns its custom tables, so direct queries (and the lack of object caching for them) are by design. -->
		<exclude name="WordPress.DB.DirectDatabaseQuery"/>

		<!-- Table names come from MLP_DB::table(); every value is bound with $wpdb->prepare(). -->
		<exclude name="WordPress.DB.PreparedSQL.NotPrepared"/>

		<!-- "mlp" is the established prefix; the sniff only objects to its length. -->
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals.ShortPrefixPassed"/>

		<!-- Private helpers are documented where behaviour is not obvious, not exhaustively. -->
		<exclude name="Squiz.Commenting.FileComment"/>
		<exclude name="Squiz.Commenting.FunctionComment.Missing"/>
		<exclude name="Squiz.Commenting.FunctionComment.MissingParamTag"/>
		<exclude name="Generic.Commenting.DocComment.MissingShort"/>

		<exclude name="Squiz.Commenting.LongConditionClosingComment"/>
		<exclude name="Squiz.Commenting.PostStatementComment"/>

		<!-- "$list" is a legal parameter name and reads better than the alternatives. -->
		<exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames"/>
	</rule>

	<!-- Admin handlers verify the nonce in MLP_Admin::guard() before reading any input. -->
	<rule ref="WordPress.Security.NonceVerification">
		<properties>
			<property name="customNonceVerificationFunctions" type="array">
				<element value="check_admin_referer"/>
			</property>
		</properties>
	</rule>

	<config name="minimum_wp_version" value="5.9"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="mailinglist-plugin"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="mlp"/>
				<element value="MLP"/>
			</property>
		</properties>
	</rule>

	<!-- Tests: fixtures touch the database directly, stub global functions and set up request state by hand. -->
	<rule ref="Generic.Files.OneObjectStructurePerFile">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="Universal.Files.SeparateFunctionsFromOO">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.ValidVariableName">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.PHP.DisallowMultipleAssignments">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Formatting.MultipleStatementAlignment">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.DB">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
</ruleset>
